# ─────────────────────────────────────────────────────────────
# VetFlow – Dockerfile do Banco H2
# Equivalente ao Dockerfile do MySQL do professor,
# mas usando H2 (banco permitido pela avaliação)
# ─────────────────────────────────────────────────────────────

FROM oscarfonts/h2:latest

# Expõe as duas portas do H2:
#   9090 → servidor TCP (usado pela API via JDBC)
#   8181 → console web (acesso pelo navegador)
EXPOSE 9090 8181
